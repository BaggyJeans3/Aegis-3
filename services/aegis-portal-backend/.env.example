# === PC 로컬 테스트용 설정 ===
# 이 파일을 복사해서 ".env" 로 이름을 바꾸고, 아래 값을 채우세요.

# SSH 터널을 통해 EC2 MongoDB에 접속하므로 localhost
MONGO_HOST=localhost
MONGO_PORT=27017

# docker-compose.yml 의 MongoDB 설정과 동일
MONGO_USER=aegis_user
MONGO_PASSWORD=여기에_MONGO_PASSWORD_값_입력

# 새로 만들 로그 DB 이름 (원하는 대로)
MONGO_DB_NAME=aegis_logs
