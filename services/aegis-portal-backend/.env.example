# === PC 로컬 테스트용 설정 ===
# 이 파일을 복사해서 ".env" 로 이름을 바꾸고, 아래 값을 채우세요.
# 서버에서는 env 파일 필요없음, GitHub Secrets 사용 중

# SSH 터널을 통해 EC2 MongoDB에 접속하므로 localhost
MONGO_HOST=localhost
MONGO_PORT=27017

# docker-compose.yml 의 MongoDB 설정과 동일
MONGO_USER=aegis_user
MONGO_PASSWORD=여기에_MONGO_PASSWORD_값_입력

# 새로 만들 로그 DB 이름 (원하는 대로)
MONGO_DB_NAME=aegis_logs

# === Supabase JWT 인증 설정 (app/auth.py) ===
# 프로젝트 URL. JWKS(공개키)와 REST API 호출에 공통으로 사용.
SUPABASE_URL=https://여기에_프로젝트_ref.supabase.co
# 토큰 aud 값. Supabase 기본값은 'authenticated'.
SUPABASE_JWT_AUDIENCE=authenticated
# user_profiles 조회용 Service Role Key (RLS 우회). 절대 외부 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=여기에_SERVICE_ROLE_KEY_값_입력
